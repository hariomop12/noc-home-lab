# ============================================================
#  NOC Home Lab — .gitignore
#  The repository stores knowledge (topologies, configs, notes,
#  captures). It never stores images, secrets or generated files.
# ============================================================

# ---------------- GNS3 QEMU / disk images ----------------
# Large, and licensed. Never committed.
*.qcow2
*.qcow
*.vmdk
*.vdi
*.img
*.bin
*.iso

# ---------------- GNS3 generated files ----------------
# project-files/ holds machine-specific fragments that break when moved
# between machines. The portable .gns3project export is what gets committed.
**/project-files/
*.gns3_perms
*.log

# ---------------- Secrets ----------------
*.pem
*.key
*.ppk
vault_pass*
.ansible/vault_pass*

# ---------------- Python / Ansible ----------------
__pycache__/
*.pyc
.venv/
venv/
*.retry

# ---------------- OS junk ----------------
.DS_Store
Thumbs.db
*~
