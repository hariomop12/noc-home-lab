# ============================================================
#  NOC Home Lab — .gitignore
#  The repository stores knowledge (topologies, configs, notes,
#  captures). It never stores images, secrets or generated files.
# ============================================================

# ---------------- GNS3 QEMU / disk images ----------------
# Large, and licensed. Never committed.
*.qcow2
*.qcow
*.vmdk
*.vdi
*.img
*.bin
*.iso

# ---------------- GNS3 generated files ----------------
# project-files/ holds machine-specific fragments that break when moved
# between machines. The portable .gns3project export is what gets committed.
**/project-files/
*.gns3_perms
*.log

# ---------------- Secrets ----------------
*.pem
*.key
*.ppk
vault_pass*
.ansible/vault_pass*

# ---------------- Python / Ansible ----------------
__pycache__/
*.pyc
.venv/
venv/
*.retry

# ---------------- containerlab generated state ----------------
# clab-<name>/ holds the live state (TLS certs, inventories, per-node config
# copies) that containerlab regenerates on every deploy. It is build output.
# The pattern is anchored: the containerlab images in docker/ must not match.
containerlab/clab-*/

# ---------------- containerlab captures ----------------
# Packet captures are kept, but only in wireshark/ where they are documented.
containerlab/**/*.pcap
containerlab/**/*.pcapng

# ---------------- OS junk ----------------
.DS_Store
Thumbs.db
*~
